import E8Leech.EvenUnimodularCounts
import E8Leech.GramPerturbation

/-!
# A lattice with an almost even unimodular Gram matrix is close to a copy of `E8`

This combines the correction of the Gram matrix (`exists_evenUnimodularGram_near`) with the
identification of even unimodular lattices of rank eight
(`EvenUnimodularGram.exists_isometry_image_e8Set_eq`). It is the form in which Step 4 of the proof
of Theorem 1.5 of Böröczky–Radchenko–Ramos is used: a basis `w` of `ℝ⁸` whose quadratic form is
within `ε` of an even unimodular integer matrix spans a lattice that a linear map `P` with
`|P x - x| ≤ ε |x|` carries onto an isometric copy of `E8`.
-/

noncomputable section

namespace E8Leech

open scoped InnerProductSpace

/-- The image of the subgroup generated by a set under a linear map. -/
theorem coe_closure_image_linearMap {d : ℕ} (P : Ambient d →ₗ[ℝ] Ambient d)
    (s : Set (Ambient d)) :
    (AddSubgroup.closure (P '' s) : Set (Ambient d)) =
      P '' (AddSubgroup.closure s : Set (Ambient d)) := by
  have h1 := AddMonoidHom.map_closure P.toAddMonoidHom s
  have h2 := congrArg (fun K : AddSubgroup (Ambient d) => (K : Set (Ambient d))) h1
  simp only [AddSubgroup.coe_map, LinearMap.toAddMonoidHom_coe] at h2
  exact h2.symm

/-- **Almost even unimodular ⇒ close to `E8`.** -/
theorem exists_isometry_e8Set_near_of_gram {w : Fin 8 → Ambient 8} (hw : LinearIndependent ℝ w)
    (M : Matrix (Fin 8) (Fin 8) ℤ) (hMs : ∀ j k, M j k = M k j) (hdet : M.det = 1)
    (heven : ∀ i, (2 : ℤ) ∣ M i i) {ε : ℝ} (hε0 : 0 ≤ ε) (hε : ε ≤ 1)
    (hquad : ∀ a : Fin 8 → ℝ, |∑ j, ∑ k, a j * (M j k : ℝ) * a k - ‖∑ j, a j • w j‖ ^ 2| ≤
      ε * ‖∑ j, a j • w j‖ ^ 2) :
    ∃ (Φ : Ambient 8 ≃ₗᵢ[ℝ] Ambient 8) (P : Ambient 8 →ₗ[ℝ] Ambient 8),
      (∀ x, ‖P x - x‖ ≤ ε * ‖x‖) ∧
        Φ '' e8Set = P '' (AddSubgroup.closure (Set.range w) : Set (Ambient 8)) := by
  obtain ⟨P, hgram, hP⟩ := exists_evenUnimodularGram_near hw M hMs hdet heven hε0 hε hquad
  obtain ⟨Φ, hΦ⟩ := hgram.exists_isometry_image_e8Set_eq
  refine ⟨Φ, P, hP, ?_⟩
  have hr : (Set.range fun j => P (w j)) = P '' Set.range w := by
    rw [← Set.range_comp]
    rfl
  rw [hΦ, ← coe_closure_image_linearMap P (Set.range w), ← hr]
  rfl

end E8Leech
