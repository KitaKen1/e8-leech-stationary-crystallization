def kernelPhiRegister : ℕ := 197
def kernelNuRegister : ℕ := 74

theorem kernelProgram_wellFormed : SLP.wellFormed kernelProgram = true := by
  decide +kernel

theorem kernelProgram_phi_checked :
    (SLP.runExpr kernelProgram []).getD kernelPhiRegister (.cst 0) = kernelPhiExpr := by
  decide +kernel

theorem kernelProgram_nu_checked :
    (SLP.runExpr kernelProgram []).getD kernelNuRegister (.cst 0) = kernelNuExpr := by
  decide +kernel

def kernelProgramModels (B : Box) (M : ℚ) (N D n K : ℕ) : List DD :=
  SLP.runDD B D (generatorDD B M N) (logarithmDD B M N D n K) kernelProgram []

theorem approx_kernelProgram_phi {B : Box} {M : ℚ} (hB : NomeOK B M)
    (hM : 4 * M < 1) (N D n K : ℕ) (hL : LogarithmOK B M N D K) {S : Env → Prop} :
    ((kernelProgramModels B M N D n K).getD kernelPhiRegister SLP.dd0).Approx B S
      (KExpr.evalA kernelPhiExpr) (KExpr.evalB kernelPhiExpr) :=
  SLP.approx_checked hB.valid D (approx_generatorDD hB hM N)
    (approx_logarithmDD hB hM N D n K hL) kernelProgram kernelPhiRegister
    kernelPhiExpr kernelProgram_phi_checked

theorem approx_kernelProgram_nu {B : Box} {M : ℚ} (hB : NomeOK B M)
    (hM : 4 * M < 1) (N D n K : ℕ) (hL : LogarithmOK B M N D K) {S : Env → Prop} :
    ((kernelProgramModels B M N D n K).getD kernelNuRegister SLP.dd0).Approx B S
      (KExpr.evalA kernelNuExpr) (KExpr.evalB kernelNuExpr) :=
  SLP.approx_checked hB.valid D (approx_generatorDD hB hM N)
    (approx_logarithmDD hB hM N D n K hL) kernelProgram kernelNuRegister
    kernelNuExpr kernelProgram_nu_checked

end E8Leech.Taylor


/-! Finite box certificates evaluated by the checked shared program. -/

namespace E8Leech.Taylor

open scoped Real

structure KernelSLPBoxCertificate (B : Box) (M : ℚ) (N D n K : ℕ) : Prop where
  nome : NomeOK B M
  e2Tail : 4 * M < 1
  logarithms : LogarithmOK B M N D K
  numerator : 0 < TM.lower B ((kernelProgramModels B M N D n K).getD kernelPhiRegister SLP.dd0).D
  denominator : 0 < TM.lower B ((kernelProgramModels B M N D n K).getD kernelNuRegister SLP.dd0).D

def kernelSLPBoxChecks (B : Box) (M : ℚ) (N D n K : ℕ) : Prop :=
  B.Valid ∧ B.ahi ≤ M ∧ B.bhi ≤ M ∧ M ≤ 1 / 2 ∧ 4 * M < 1 ∧
    (∀ j : Fin 3,
      TM.absBound B ((generatorDD B M N (logarithmIndex j)).A.sub (TM.const 1)) < 1 ∧
      TM.absBound B ((generatorDD B M N (logarithmIndex j)).B.sub (TM.const 1)) < 1 ∧
      TM.absBound B (DD.logZ B D K (generatorDD B M N (logarithmIndex j))) < 1) ∧
    (let regs := kernelProgramModels B M N D n K
     0 < TM.lower B (regs.getD kernelPhiRegister SLP.dd0).D ∧
       0 < TM.lower B (regs.getD kernelNuRegister SLP.dd0).D)

instance instDecidableKernelSLPBoxChecks (B : Box) (M : ℚ) (N D n K : ℕ) :
    Decidable (kernelSLPBoxChecks B M N D n K) := by
  unfold kernelSLPBoxChecks Box.Valid
  infer_instance

def checkKernelSLPBox (B : Box) (M : ℚ) (N D n K : ℕ) : Bool :=
  decide (kernelSLPBoxChecks B M N D n K)

theorem kernelSLPBoxCertificate_of_check {B : Box} {M : ℚ} {N D n K : ℕ}
    (h : checkKernelSLPBox B M N D n K = true) : KernelSLPBoxCertificate B M N D n K := by
  have hc : kernelSLPBoxChecks B M N D n K := of_decide_eq_true h
  obtain ⟨hv, ha, hb, hm, he, hl, hp, hq⟩ := hc
  exact ⟨⟨hv, ha, hb, hm⟩, he, ⟨fun j => (hl j).1, fun j => (hl j).2.1,
    fun j => (hl j).2.2⟩, hp, hq⟩

theorem ckmrvEightHatKernel_pos_of_slp_box_certificate {B : Box} {M : ℚ} {N D n K : ℕ}
    (hC : KernelSLPBoxCertificate B M N D n K) {u t : ℝ} (hu : 0 < u) (ht : 0 < t)
    (hJ : kleinModularJ (imagPt u) ≠ kleinModularJ (imagPt t)) (he : B.Mem (axisEnv u t)) :
    0 < (ckmrvEightHatKernel (imagPt u) (imagPt t)).re := by
  have hut : u ≠ t := by
    intro h
    subst t
    exact hJ rfl
  have hab : (axisEnv u t).a ≠ (axisEnv u t).b := by
    intro h
    have h' := Real.exp_injective h
    apply hut
    change -π * u = -π * t at h'
    nlinarith [Real.pi_pos]
  have hP := approx_kernelProgram_phi hC.nome hC.e2Tail N D n K hC.logarithms
    (S := fun _ => True)
  have hQ := approx_kernelProgram_nu hC.nome hC.e2Tail N D n K hC.logarithms
    (S := fun _ => True)
  have hp := TM.pos_of_lower_pos hC.nome.valid hP.2.2 hC.numerator he ⟨trivial, hab⟩
  have hq := TM.pos_of_lower_pos hC.nome.valid hQ.2.2 hC.denominator he ⟨trivial, hab⟩
  rw [kernelPhiExpr_evalA_zero _ rfl ht.ne', sub_zero, kernelPhiExpr_eval_axis hu ht] at hp
  rw [kernelNuExpr_evalA_zero, sub_zero, kernelNuExpr_eval_axis hu ht] at hq
  rw [← ckmrvEightHatKernel_axis hu ht hJ] at hp
  have hmul : 0 < 2 * (ckmrvEightHatKernel (imagPt u) (imagPt t)).re *
      (axNu (axV u) (axW u) (axV t) (axW t) / ((axisEnv u t).b - (axisEnv u t).a)) := by
    convert hp using 1
    ring
  by_contra h
  have hnonpos : 2 * (ckmrvEightHatKernel (imagPt u) (imagPt t)).re ≤ 0 := by
    linarith [not_lt.mp h]
  have := mul_nonpos_of_nonpos_of_nonneg hnonpos hq.le
  linarith

theorem ckmrvEightHatKernel_pos_of_checked_slp_box {B : Box} {M : ℚ} {N D n K : ℕ}
    (h : checkKernelSLPBox B M N D n K = true) {u t : ℝ} (hu : 0 < u) (ht : 0 < t)
    (hJ : kleinModularJ (imagPt u) ≠ kleinModularJ (imagPt t)) (he : B.Mem (axisEnv u t)) :
    0 < (ckmrvEightHatKernel (imagPt u) (imagPt t)).re :=
  ckmrvEightHatKernel_pos_of_slp_box_certificate (kernelSLPBoxCertificate_of_check h) hu ht hJ he

end E8Leech.Taylor


/-! The first nonempty rational-box certificate for the actual E8 hat kernel. -/

namespace E8Leech.Taylor

open scoped Real

def firstKernelBox : Box :=
  ⟨1506 / 10000000000, 1508 / 10000000000,
    3486 / 1000000000, 3489 / 1000000000,
    49999 / 10000, 50001 / 10000, 39999 / 10000, 40001 / 10000,
    3141592 / 1000000, 3141593 / 1000000, 69 / 100, 7 / 10⟩

set_option maxHeartbeats 0
set_option maxRecDepth 32768

theorem firstKernelBox_checked :
    checkKernelSLPBox firstKernelBox (3489 / 1000000000) 1 3 2 2 = true := by
  decide +kernel

end E8Leech.Taylor
