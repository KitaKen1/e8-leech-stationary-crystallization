import Mathlib.Data.List.GetD


/-!
# Checking shared programs against their source expressions

A compiler may suggest a program, but its output is accepted only after symbolic execution
recovers the requested `KExpr`. The checker also works for hand-written or externally generated
programs. Its soundness does not assume that the compiler is correct.
-/

namespace E8Leech.Taylor

deriving instance DecidableEq for KExpr
deriving instance DecidableEq for Instr

namespace SLP

def stepExpr (regs : List KExpr) : Instr → KExpr
  | .zgen i => .zgen i
  | .tgen i => .tgen i
  | .zlog j => .zlog j
  | .tlog j => .tlog j
  | .cst q => .cst q
  | .mono m => .mono m
  | .add i j => .add (regs.getD i (.cst 0)) (regs.getD j (.cst 0))
  | .sub i j => .sub (regs.getD i (.cst 0)) (regs.getD j (.cst 0))
  | .mul i j => .mul (regs.getD i (.cst 0)) (regs.getD j (.cst 0))

def runExpr : List Instr → List KExpr → List KExpr
  | [], regs => regs
  | ins :: rest, regs => runExpr rest (regs ++ [stepExpr regs ins])

noncomputable def eval (side : Bool) (e : Env) (x : KExpr) : ℝ :=
  if side then KExpr.evalA x e else KExpr.evalB x e

theorem eval_getD (side : Bool) (e : Env) (regs : List KExpr) (k : ℕ) :
    (regs.map (eval side e)).getD k 0 = eval side e (regs.getD k (.cst 0)) := by
  have h0 : eval side e (.cst 0) = 0 := by
    cases side <;> simp [eval, KExpr.evalA, KExpr.evalB]
  simpa only [h0] using List.getD_map (l := regs) (d := KExpr.cst 0) (n := k) (eval side e)

theorem eval_stepExpr (side : Bool) (e : Env) (regs : List KExpr) (ins : Instr) :
    eval side e (stepExpr regs ins) = stepR side e (regs.map (eval side e)) ins := by
  cases ins <;> simp only [stepExpr, stepR, eval_getD] <;> cases side <;> rfl

theorem eval_runExpr (side : Bool) (e : Env) (prog : List Instr) (regs : List KExpr) :
    (runExpr prog regs).map (eval side e) = runR side e prog (regs.map (eval side e)) := by
  induction prog generalizing regs with
  | nil => rfl
  | cons ins rest ih =>
    simp only [runExpr, runR, ih, List.map_append, List.map_cons, List.map_nil, eval_stepExpr]

theorem eval_runExpr_getD (side : Bool) (e : Env) (prog : List Instr) (k : ℕ) :
    eval side e ((runExpr prog []).getD k (.cst 0)) = (runR side e prog []).getD k 0 := by
  rw [← eval_getD, eval_runExpr]
  rfl

/-- A finite syntactic equality is enough to certify the real meaning of an output. -/
theorem approx_checked {B : Box} (hB : B.Valid) (D : ℕ) {S : Env → Prop}
    {G : Fin 5 → DD} {L : Fin 3 → DD}
    (hG : ∀ i, (G i).Approx B S (fun e => genFun i e.a) (fun e => genFun i e.b))
    (hL : ∀ j, (L j).Approx B S (fun e => logFun j e.a) (fun e => logFun j e.b))
    (prog : List Instr) (k : ℕ) (x : KExpr) (h : (runExpr prog []).getD k (.cst 0) = x) :
    ((runDD B D G L prog []).getD k dd0).Approx B S (KExpr.evalA x) (KExpr.evalB x) := by
  have ha : (fun e => (runR true e prog []).getD k 0) = KExpr.evalA x := by
    funext e
    rw [← eval_runExpr_getD, h]
    rfl
  have hb : (fun e => (runR false e prog []).getD k 0) = KExpr.evalB x := by
    funext e
    rw [← eval_runExpr_getD, h]
    rfl
  simpa only [ha, hb] using approx_run hB D hG hL prog k

/-- Require arithmetic instructions to refer to registers already emitted. -/
def referencesBefore (k : ℕ) : Instr → Bool
  | .add i j | .sub i j | .mul i j => decide (i < k ∧ j < k)
  | _ => true

def wellFormed (prog : List Instr) : Bool :=
  (prog.zipIdx).all fun ik => referencesBefore ik.2 ik.1

structure CompileState where
  expressions : List KExpr := []
  instructions : List Instr := []

def emit (s : CompileState) (x : KExpr) (ins : Instr) : CompileState × ℕ :=
  (⟨s.expressions ++ [x], s.instructions ++ [ins]⟩, s.instructions.length)

/-- Candidate compiler with exact common-subexpression sharing. The checker above is trusted,
not this search procedure. -/
def compile (x : KExpr) (s : CompileState) : CompileState × ℕ :=
  match s.expressions.findIdx? (fun y => decide (y = x)) with
  | some k => (s, k)
  | none =>
    match x with
    | .zgen i => emit s x (.zgen i)
    | .tgen i => emit s x (.tgen i)
    | .zlog j => emit s x (.zlog j)
    | .tlog j => emit s x (.tlog j)
    | .cst q => emit s x (.cst q)
    | .mono m => emit s x (.mono m)
    | .add a b =>
      let (s, i) := compile a s
      let (s, j) := compile b s
      emit s x (.add i j)
    | .sub a b =>
      let (s, i) := compile a s
      let (s, j) := compile b s
      emit s x (.sub i j)
    | .mul a b =>
      let (s, i) := compile a s
      let (s, j) := compile b s
      emit s x (.mul i j)

end SLP

end E8Leech.Taylor


