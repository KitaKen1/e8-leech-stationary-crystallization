import E8Leech.E8FrameFromCounts
import Mathlib.LinearAlgebra.Matrix.NonsingularInverse
import Mathlib.LinearAlgebra.Matrix.Adjugate

/-!
# Even unimodular lattices of rank eight from a Gram matrix

Eight vectors of `ℝ⁸` whose Gram matrix is an integer matrix `M` of determinant one with even
diagonal span an even unimodular lattice. This file collects the algebraic consequences that the
identification of `E8` uses; no measure theory is involved.

* `EvenUnimodularGram`: the hypothesis on the vectors.
* `EvenUnimodularGram.linearIndependent`, `EvenUnimodularGram.basis`: the vectors are a basis.
* `EvenUnimodularGram.lattice`: the subgroup they generate.
* `EvenUnimodularGram.integral`, `EvenUnimodularGram.even`: inner products are integers and squared
  norms are even integers.
* `EvenUnimodularGram.exists_coeffs`: every lattice vector is an integer combination.
* `EvenUnimodularGram.selfDual`: a vector with integer inner products with the lattice lies in
  the lattice (the inverse of `M` over `ℤ` is its adjugate).
-/

noncomputable section

namespace E8Leech

open scoped InnerProductSpace
open Finset Matrix

/-- Eight vectors with an integral Gram matrix of determinant one and even diagonal. -/
structure EvenUnimodularGram (z : Fin 8 → Ambient 8) (M : Matrix (Fin 8) (Fin 8) ℤ) : Prop where
  gram : ∀ i j, ⟪z i, z j⟫_ℝ = (M i j : ℝ)
  det : M.det = 1
  even : ∀ i, (2 : ℤ) ∣ M i i

namespace EvenUnimodularGram

variable {z : Fin 8 → Ambient 8} {M : Matrix (Fin 8) (Fin 8) ℤ}

/-- The Gram matrix is symmetric. -/
theorem symm (h : EvenUnimodularGram z M) (i j : Fin 8) : M i j = M j i := by
  have e : (M i j : ℝ) = (M j i : ℝ) := by rw [← h.gram i j, ← h.gram j i, real_inner_comm]
  exact_mod_cast e

/-- The vectors are linearly independent. -/
theorem linearIndependent (h : EvenUnimodularGram z M) : LinearIndependent ℝ z := by
  rw [Fintype.linearIndependent_iff]
  intro r hr
  have hdet : (M.map (Int.castRingHom ℝ)).det ≠ 0 := by
    have e : (M.map (Int.castRingHom ℝ)).det = ((M.det : ℤ) : ℝ) := by
      rw [← RingHom.mapMatrix_apply, ← RingHom.map_det]
      rfl
    rw [e, h.det]
    norm_num
  have hv : r ᵥ* M.map (Int.castRingHom ℝ) = 0 := by
    funext j
    have e : ⟪∑ i, r i • z i, z j⟫_ℝ = ∑ i, r i * (M i j : ℝ) := by
      rw [sum_inner]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [real_inner_smul_left, h.gram i j]
    rw [hr, inner_zero_left] at e
    simp only [Matrix.vecMul, dotProduct, Matrix.map_apply, Int.coe_castRingHom, Pi.zero_apply]
    exact e.symm
  have h0 := Matrix.eq_zero_of_vecMul_eq_zero hdet hv
  intro i
  exact congrFun h0 i

/-- The vectors as a basis of `ℝ⁸`. -/
def basis (h : EvenUnimodularGram z M) : Module.Basis (Fin 8) ℝ (Ambient 8) :=
  basisOfLinearIndependentOfCardEqFinrank h.linearIndependent (by simp)

theorem basis_apply (h : EvenUnimodularGram z M) (i : Fin 8) : h.basis i = z i := by
  simp [basis]

/-- A vector orthogonal to all eight vectors is zero. -/
theorem eq_zero_of_inner_eq_zero (h : EvenUnimodularGram z M) {w : Ambient 8}
    (hw : ∀ j, ⟪w, z j⟫_ℝ = 0) : w = 0 := by
  have e : w = ∑ j, h.basis.repr w j • z j := by
    conv_lhs => rw [← h.basis.sum_repr w]
    exact Finset.sum_congr rfl fun j _ => by rw [h.basis_apply j]
  have hself : ⟪w, w⟫_ℝ = 0 := by
    conv_lhs => arg 2; rw [e]
    rw [sum_inner]
    refine Finset.sum_eq_zero fun j _ => ?_
    rw [real_inner_smul_left, real_inner_comm, hw j, mul_zero]
  exact inner_self_eq_zero.mp hself

/-- The lattice generated by the vectors. -/
def lattice (_h : EvenUnimodularGram z M) : AddSubgroup (Ambient 8) :=
  AddSubgroup.closure (Set.range z)

theorem mem_lattice (h : EvenUnimodularGram z M) (i : Fin 8) : z i ∈ h.lattice :=
  AddSubgroup.subset_closure ⟨i, rfl⟩

/-- Inner products of a lattice vector with the generators are integers. -/
theorem integral_right (h : EvenUnimodularGram z M) {x : Ambient 8} (hx : x ∈ h.lattice)
    (j : Fin 8) : ∃ m : ℤ, ⟪x, z j⟫_ℝ = m := by
  refine AddSubgroup.closure_induction (p := fun x _ => ∃ m : ℤ, ⟪x, z j⟫_ℝ = m) ?_ ?_ ?_ ?_ hx
  · rintro _ ⟨i, rfl⟩
    exact ⟨M i j, h.gram i j⟩
  · exact ⟨0, by simp⟩
  · rintro x y _ _ ⟨m, hm⟩ ⟨n, hn⟩
    exact ⟨m + n, by rw [inner_add_left, hm, hn]; push_cast; ring⟩
  · rintro x _ ⟨m, hm⟩
    exact ⟨-m, by rw [inner_neg_left, hm]; push_cast; ring⟩

/-- The lattice is integral. -/
theorem integral (h : EvenUnimodularGram z M) {x y : Ambient 8} (hx : x ∈ h.lattice)
    (hy : y ∈ h.lattice) : ∃ m : ℤ, ⟪x, y⟫_ℝ = m := by
  refine AddSubgroup.closure_induction (p := fun y _ => ∃ m : ℤ, ⟪x, y⟫_ℝ = m) ?_ ?_ ?_ ?_ hy
  · rintro _ ⟨j, rfl⟩
    exact h.integral_right hx j
  · exact ⟨0, by simp⟩
  · rintro a b _ _ ⟨m, hm⟩ ⟨n, hn⟩
    exact ⟨m + n, by rw [inner_add_right, hm, hn]; push_cast; ring⟩
  · rintro a _ ⟨m, hm⟩
    exact ⟨-m, by rw [inner_neg_right, hm]; push_cast; ring⟩

/-- The lattice is even. -/
theorem even_norm_sq (h : EvenUnimodularGram z M) {x : Ambient 8} (hx : x ∈ h.lattice) :
    ∃ k : ℤ, ‖x‖ ^ 2 = 2 * k := by
  refine AddSubgroup.closure_induction
    (p := fun x _ => x ∈ h.lattice ∧ ∃ k : ℤ, ‖x‖ ^ 2 = 2 * k) ?_ ?_ ?_ ?_ hx |>.2
  · rintro _ ⟨i, rfl⟩
    obtain ⟨k, hk⟩ := h.even i
    refine ⟨h.mem_lattice i, k, ?_⟩
    rw [← real_inner_self_eq_norm_sq, h.gram i i, hk]
    push_cast
    ring
  · exact ⟨h.lattice.zero_mem, 0, by simp⟩
  · rintro a b _ _ ⟨ha, k, hk⟩ ⟨hb, l, hl⟩
    obtain ⟨m, hm⟩ := h.integral ha hb
    refine ⟨h.lattice.add_mem ha hb, k + m + l, ?_⟩
    rw [norm_add_sq_real, hk, hl, hm]
    push_cast
    ring
  · rintro a _ ⟨ha, k, hk⟩
    exact ⟨h.lattice.neg_mem ha, k, by rw [norm_neg, hk]⟩

/-- Every lattice vector is an integer combination of the generators. -/
theorem exists_coeffs (h : EvenUnimodularGram z M) {x : Ambient 8} (hx : x ∈ h.lattice) :
    ∃ a : Fin 8 → ℤ, x = ∑ i, a i • z i := by
  have hx' : x ∈ Submodule.span ℤ (Set.range z) := by
    have e := Submodule.span_int_eq_addSubgroupClosure (Set.range z)
    have hx'' : x ∈ (Submodule.span ℤ (Set.range z)).toAddSubgroup := by
      rw [e]
      exact hx
    exact hx''
  obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun ℤ).mp hx'
  exact ⟨a, ha.symm⟩

/-- **Self-duality.** A vector with integer inner products with all lattice vectors lies in the
lattice. -/
theorem selfDual (h : EvenUnimodularGram z M) {w : Ambient 8}
    (hw : ∀ x ∈ h.lattice, ∃ n : ℤ, ⟪w, x⟫_ℝ = n) : w ∈ h.lattice := by
  choose n hn using fun j => hw (z j) (h.mem_lattice j)
  -- the coefficients `M⁻¹ n` over `ℤ`
  let c : Fin 8 → ℤ := M.adjugate *ᵥ n
  have hMc : M *ᵥ c = n := by
    simp only [c, Matrix.mulVec_mulVec, Matrix.mul_adjugate, h.det, one_smul, Matrix.one_mulVec]
  have hmem : ∑ i, c i • z i ∈ h.lattice :=
    h.lattice.sum_mem fun i _ => h.lattice.zsmul_mem (h.mem_lattice i) (c i)
  have hzero : w - ∑ i, c i • z i = 0 := by
    refine h.eq_zero_of_inner_eq_zero fun k => ?_
    have e : ⟪∑ i, c i • z i, z k⟫_ℝ = ((M *ᵥ c) k : ℝ) := by
      rw [sum_inner]
      simp only [Matrix.mulVec, dotProduct]
      push_cast
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [← Int.cast_smul_eq_zsmul ℝ, real_inner_smul_left, h.gram i k, h.symm k i]
      ring
    rw [inner_sub_left, hn k, e, hMc, sub_self]
  rw [sub_eq_zero.mp hzero]
  exact hmem

end EvenUnimodularGram

end E8Leech
