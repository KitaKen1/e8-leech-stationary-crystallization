module

public import Mathlib.Analysis.InnerProductSpace.PiL2
public import Mathlib.Analysis.SpecialFunctions.Pow.NNReal
public import Mathlib.MeasureTheory.Integral.Lebesgue.Map
public import Mathlib.MeasureTheory.Measure.Count
public import Mathlib.MeasureTheory.Measure.Haar.InnerProductSpace
public import Mathlib.MeasureTheory.Measure.Typeclasses.Probability
public import Mathlib.Topology.Homeomorph.Lemmas
public import Mathlib.Topology.MetricSpace.Isometry

/-!
# Simple point configurations and stationary Riesz energy

Configurations carry the sigma-algebra generated by Borel-window point counts.
-/

@[expose] public section

noncomputable section
namespace PointProcess
open Set MeasureTheory
open scoped ENNReal

abbrev Ambient (d : ℕ) := EuclideanSpace ℝ (Fin d)

/-- Simple configurations that are finite on every compact set. -/
structure Configuration (X : Type*) [TopologicalSpace X] where
  support : Set X
  finite_on_compacts : ∀ K : Set X, IsCompact K → (support ∩ K).Finite

instance {X : Type*} [TopologicalSpace X] [MeasurableSpace X]
    [MeasurableSingletonClass X] : MeasurableSpace (Configuration X) :=
  ⨆ A : {A : Set X // MeasurableSet A},
    MeasurableSpace.comap
      (fun c : Configuration X => Measure.count (c.support ∩ A.1)) inferInstance

/-- Translate a configuration by a deterministic vector. -/
def translate {d : ℕ} (a : Ambient d) (c : Configuration (Ambient d)) :
    Configuration (Ambient d) where
  support := (Homeomorph.addLeft a) '' c.support
  finite_on_compacts K hK := by
    let e := Homeomorph.addLeft a
    have h := (c.finite_on_compacts (e ⁻¹' K) (e.isCompact_preimage.mpr hK)).image e
    simpa only [Set.image_inter_preimage] using h

/-- Invariance under every deterministic translation. -/
def IsStationary {d : ℕ} (μ : Measure (Configuration (Ambient d))) : Prop :=
  ∀ a : Ambient d, MeasurePreserving (translate a) μ μ

/-- Expected point count in every Borel window. -/
def HasIntensity {d : ℕ} (μ : Measure (Configuration (Ambient d))) (ρ : ℝ≥0∞) : Prop :=
  ∀ W : Set (Ambient d), MeasurableSet W →
    (∫⁻ c, Measure.count (c.support ∩ W) ∂μ) = ρ * volume W


/-- Ordered Riesz energy, with the second point unrestricted. -/
def rieszEnergy {d : ℕ} (s : ℝ) (μ : Measure (Configuration (Ambient d))) : ℝ≥0∞ := by
  classical
  exact
    ∫⁻ c, ∑' x : c.support,
      if (x : Ambient d) ∈ {u | ∀ i, u i ∈ Set.Ico (0 : ℝ) 1} then
        ∑' y : c.support, if (y : Ambient d) = x then 0
          else ENNReal.ofReal (dist (x : Ambient d) y) ^ (-s)
      else 0 ∂μ

/-- The off-diagonal Riesz energy seen from a lattice point. -/
def latticeRieszEnergy {d : ℕ} (Λ : Set (Ambient d)) (s : ℝ) : ℝ≥0∞ := by
  classical
  exact
    ∑' z : Λ, if (z : Ambient d) = 0 then 0
      else ENNReal.ofReal (dist (0 : Ambient d) z) ^ (-s)

/-- Two-sided lattice matching and a point-count lower bound on a closed ball. -/
def LocalCrystal {d : ℕ} (Λ : Set (Ambient d))
    (c : Configuration (Ambient d)) (R error loss : ℝ) : Prop :=
  (∃ Φ : Ambient d ≃ᵢ Ambient d, ∃ Z : Finset (Ambient d),
    (↑Z : Set (Ambient d)) ⊆ Λ ∧
    (∀ x ∈ c.support ∩ Metric.closedBall 0 R, ∃ z ∈ Z, dist x (Φ z) ≤ error) ∧
    (∀ z ∈ Z, ∃ x ∈ c.support ∩ Metric.closedBall 0 R, dist (Φ z) x ≤ error)) ∧
  ENNReal.ofReal (1 - loss) * volume (Metric.closedBall (0 : Ambient d) R) ≤
    Measure.count (c.support ∩ Metric.closedBall 0 R)

/-- Translation has the expected action on the support. -/
@[simp] theorem translate_support {d : ℕ} (a : Ambient d)
    (c : Configuration (Ambient d)) :
    (translate a c).support = (Homeomorph.addLeft a) '' c.support := rfl

/-- Borel-window counts are measurable for the counting sigma-algebra. -/
theorem measurable_count {d : ℕ} {A : Set (Ambient d)} (hA : MeasurableSet A) :
    Measurable (fun c : Configuration (Ambient d) => Measure.count (c.support ∩ A)) := by
  apply Measurable.of_comap_le
  exact le_iSup_of_le (⟨A, hA⟩ : {A : Set (Ambient d) // MeasurableSet A}) le_rfl

end PointProcess
